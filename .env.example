# --- Seaweed Setup ---
SEAWEEDFS_ENDPOINT=http://localhost:8333
SEAWEEDFS_ACCESS_KEY=your_s3_access_key
SEAWEEDFS_SECRET_KEY=your_s3_secret_key
SEAWEEDFS_BUCKET=experiment-files