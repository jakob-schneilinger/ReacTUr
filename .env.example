# --- PostgreSQL Setup ---
POSTGRES_USER=kinetics_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=kineticsdb

DB_HOST=localhost

# --- Keycloak Setup ---
KEYCLOAK_ADMIN_USER=admin
